@using Campus_SMS.Data
@model IEnumerable<Campus_SMS.Entities.ClassCourse>

@{
    ViewData["Title"] = "Index";
}

<h1 class="text-center">My Classes</h1>

<p class="d-grid gap-2">
    <a asp-action="Create" class="btn btn-outline-primary">Add Class</a>
</p>

<div class="col border border-white p-2 rounded-2 shadow">
    <table class="display" id="CourseTable">
        <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ClassDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UsiClassIdentifier)
            </th>
            <th>Faculty Members</th>
            <th>Upload Files</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ClassDescription)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UsiClassIdentifier)
                </td>
                <td>
                    @foreach (var faculty in item.AppUsers)
                    {
                        <p>@faculty</p>
                    }
                </td>
                <td>
                    <!-- Add file upload form -->
                    <form asp-action="UploadFile" asp-route-id="@item.Id" method="post" enctype="multipart/form-data">
                        <input type="file" name="file" />
                        <input type="submit" value="Upload" class="btn btn-primary" />
                    </form>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a> |
                    <a asp-action="ChatLog" asp-route-id="@item.Id">Chat Log</a>

                </td>
            </tr>
        }
        </tbody>
    </table>

</div>


@section Scripts {
    <script type="text/javascript" src="~/js/ClassTableInitialize.js"></script>
}