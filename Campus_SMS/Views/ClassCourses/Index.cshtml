@using Campus_SMS.Data
@model IEnumerable<Campus_SMS.Entities.ClassCourse>

@{
    ViewData["Title"] = "Index";
}

<style>
    /* Initially hide the "down" chevron */
    .toggle-btn svg.chevron-down {
        display: none;
    }

    /* When expanded, swap the icons */
    .toggle-btn[aria-expanded="true"] svg.chevron-up {
        display: none;
    }

    .toggle-btn[aria-expanded="true"] svg.chevron-down {
        display: inline;
    }

    /* Ensure collapse content is initially hidden and smoothly transition */
    .collapse tr{
        height: 0;
        overflow: hidden;
        transition: height 0.5s ease; /* Smooth transition on height */
    }

    /* When collapsed, allow content to expand smoothly */
    .collapse.show tr{
        height: auto;
        transition: height 0.5s ease; /* Smooth transition on height */
    }

    tr:hover {
        filter: brightness(1.4); /* Increases brightness by 20% */
        transition: filter 0.3s ease-in-out; /* Smooth transition */
    }


</style>

<h1 class="text-center">My Classes</h1>

<p class="d-grid gap-2">
    <a asp-action="Create" class="btn btn-outline-primary">Add Class</a>
</p>

<div class="col border border-white p-2 rounded-2 shadow container shadow min-vh-100 py-2">
        <div class="table-responsive">
            <table class="table accordion display table-striped" id="CourseTable">
                <thead>
                    <tr>
                        <th scope="col"></th>
                        <th scope="col">@Html.DisplayNameFor(model => model.ClassDescription)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.UsiClassIdentifier)</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model)
                    {
                        var uniqueIdentifier = Guid.NewGuid();
                        <tr role="button" data-bs-target="#hidden-row-@uniqueIdentifier">
                            <th scope="row">
                                <button class="btn toggle-btn" data-bs-toggle="collapse" data-bs-target="#hidden-row-@uniqueIdentifier" aria-expanded="false">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi chevron-up" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M7.646 4.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1-.708.708L8 5.707l-5.646 5.647a.5.5 0 0 1-.708-.708z" />
                                    </svg>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi chevron-down" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708" />
                                    </svg>
                                </button>
                            </th>
                            <td>
                                @Html.DisplayFor(modelItem => item.ClassDescription)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.UsiClassIdentifier)
                            </td>
                            <td>
                                <div id="actions-@item.Id">
                                    <div class="d-flex flex-wrap gap-2">
                                        <a asp-action="ChatLog" asp-route-id="@item.Id" class="btn btn-outline-primary" onclick="event.stopPropagation();">
                                            <i class="bi bi-chat-dots me-1"></i> Chat Log
                                        </a>
                                        <a asp-action="Documents" asp-route-id="@item.Id" class="btn btn-outline-secondary" onclick="event.stopPropagation();">
                                            <i class="bi bi-folder me-1"></i> Course Docs
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" onclick="event.stopPropagation();">
                                            <i class="bi bi-info-circle me-1"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-success" onclick="event.stopPropagation();">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </a>
                                        <a asp-action="BlockNumber" asp-route-id="@item.Id" class="btn btn-outline-danger" onclick="event.stopPropagation();">
                                            <i class="bi bi-slash-circle me-1"></i> Blocked Numbers
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-warning" onclick="event.stopPropagation();">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr class="collapse accordion-collapse rounded-3 border border-2 shadow-lg hidden-row ps-3 pe-3" id="hidden-row-@uniqueIdentifier">
                            <td class="shadow-lg rounded-3" colspan="5">
                                <ul class="list-group">
                                    @if (item.AppUsers.Count > 0)
                                    {
                                        <li class="list-group-item fw-bold text-center text-white shadow-lg">Faculty Members</li> <!-- Header -->
                                    }
                                    else
                                    {
                                        <li class="list-group-item fw-bold text-center text-danger shadow-lg">No Faculty Members Assigned</li> <!-- Header -->
                                    }
                                    @foreach (var user in item.AppUsers)
                                    {
                                        <li class="list-group-item text-center text-white shadow-lg bg-dark border h5">@user.Email</li>
                                    }
                                </ul>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/ClassTableInitialize.js"></script>
    <script>
        let override = false;

        function updateFileName(input, itemId) {
            const fileNameSpan = document.getElementById("fileName-" + itemId);
            fileNameSpan.textContent = input.files.length > 0 ? input.files[0].name : "No file chosen";
        }

        async function validateFileUpload(event, form, itemId) {
            event.preventDefault()
            const fileInput = form.querySelector("input[type='file']");
            const fileError = form.querySelector(".text-danger");

            if (!fileInput.files.length) {
                fileError.textContent = "Please select a file to upload.";
                fileError.style.display = "block";
                event.preventDefault();
                return false;
            }

            const fileName = fileInput.files[0].name;
            console.log("Selected file:", fileName);
            // Send AJAX request to check if file exists
            const exists = await checkFileExists(itemId,fileName);

            if (exists) {
                if (!override)
                {
                    override = true;
                    fileError.textContent = "This file already exists. Pressing upload again will overwrite it!";
                    fileError.style.display = "block";
                    event.preventDefault();
                    return false;
                }
                else
                {
                    try {
                        const response = await fetch(`/ClassCourses/DeleteFile?id=${itemId}&docName=${encodeURIComponent(fileName)}`);

                        if (!response.ok) {
                            console.log("Error: Server response was not OK.");
                            return false;
                        }

                        console.log("Server response: Overwriting file ");

                    } catch (error) {
                        console.error("Error overwriting file:", error);
                    }
                }
            }

            console.log("File does not exist, proceeding with upload.");
            fileError.style.display = "none";
            form.submit();
            return true;
        }

        async function checkFileExists(itemid,fileName) {
            try {
                const response = await fetch(`/ClassCourses/CheckFileExists?filename=${encodeURIComponent(fileName)}&id=${itemid}`);

                if (!response.ok) {
                    console.log("Error: Server response was not OK.");
                    return false;
                }

                const data = await response.json();
                console.log("Server response:", data);

                return data.exists;
            } catch (error) {
                console.error("Error checking file:", error);
                return false;
            }
        }

</script>
}