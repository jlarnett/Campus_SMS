@using System.IO
@model Campus_SMS.Entities.ClassCourse
@inject IWebHostEnvironment Env

@{
    ViewData["Title"] = $"{Model.UsiClassIdentifier} Course Documents";
}

<h1 class="text-center">@Model.UsiClassIdentifier Course Documents</h1>

@{
    var pathToCourseDocuments = System.IO.Path.Combine(Env.ContentRootPath, Model.CourseDocuments ?? string.Empty);
    FileInfo[] files = [];

    if (Directory.Exists(pathToCourseDocuments))
    {
        var directoryInfo = new DirectoryInfo(pathToCourseDocuments);
        files = directoryInfo.GetFiles();
    }

}

<div class="container border border-white rounded-2 shadow-lg p-2">
    <table class="table table-striped" id="CourseDocuments">
        <thead>
            <tr>
                <th class="col">
                    Document Name
                </th>
                <th class="col">
                    Actions
                </th>
            </tr>
        </thead>
        <tbody>
        @{
            foreach (var item in files)
            {
                <tr>
                    <td>
                        @item.Name
                    </td>
                    <td>
                            <a asp-action="DeleteFile" asp-route-id="@Model.Id" asp-route-docName="@item.Name" class=" btn btn-outline-danger"><span>Remove Document</span></a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script type="text/javascript" src="~/js/CourseDocumentTableInitialize.js"></script>
}