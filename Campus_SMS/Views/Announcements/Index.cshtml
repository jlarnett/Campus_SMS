@model IEnumerable<Campus_SMS.Entities.Announcement>

@{
    ViewData["Title"] = "Index";
}

<h1 class="text-center">Recent Announcements</h1>

<p class="d-grid gap-2">
    <a asp-action="Create" class="btn btn-outline-primary">Send Announcement</a>
</p>
<div class="col border border-white p-2 rounded-2 shadow">
    <table class="Display" id="AnnouncementTable">
        <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OutboundMessage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Course)
            </th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.OutboundMessage)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Course.UsiClassIdentifier)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

</div>

@section Scripts {
    <script type="text/javascript" src="~/js/AnnouncementTableInitialize.js"></script>
}