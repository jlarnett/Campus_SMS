@using Campus_SMS.Views.Admin.Vms
@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}
<script src="~/js/tabs.js" defer></script>
<link href="~/css/admin.css" rel="stylesheet">
<div class="admin-dashboard">
    <!-- Header -->
    <header class="admin-header">
        <h1>Hello, @User.Identity.Name</h1>
    </header>
    <!-- Top Tab Navigation -->
    <ul class="tabs-nav">
        <li data-tab-target="#faculty" class="tab active">Faculty</li>
        <li data-tab-target="#students" class="tab">Students</li>
        <li data-tab-target="#courses" class="tab">Course Management</li>
    </ul>
    
    @{
        @foreach (var sms in Model.SmsInteractions)
        {
            <div>@sms.IncomingSmsMessage</div>
        }
    }
    
    @{
        @foreach (var announcement in Model.Announcements)
        {
            <div>@announcement.OutboundMessage</div>
        }
    }
    
    @{
        @foreach (var smsUser in Model.SmsUsers)
        {
            <div>@smsUser.PhoneNumber</div>
        }
    }


</div>