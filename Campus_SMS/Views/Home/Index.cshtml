@model Campus_SMS.Views.Home.Vms.DashboardVm
@using Campus_SMS.Entities.User
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> _signInManager;

@{
    ViewData["Title"] = "Admin Dashboard";
}

@if (_signInManager.IsSignedIn(User))
{
    <div class="d-flex justify-content-center align-items-center shadow rounded-3">
        <h3 class="display-6">Faculty Dashboard</h3>
        <!-- Info Icon with Tooltip -->
        <i class="bi bi-info-circle" data-bs-toggle="tooltip" data-bs-placement="top" title="Data displayed on Faculty Dashboard is specific to you" style="font-size: 24px; margin-left: 10px; cursor: pointer;"></i>
    </div>
    <div class="container mt-4 shadow rounded-2">
        <div class="row">
            <!-- Column 1 -->
            <div class="col d-flex flex-column justify-content-start p-2 border-end border-bottom border-success">
                <h2 class="text-center mb-3">SMS Count</h2>
                <canvas id="chart1" class="mt-5"></canvas>
            </div>

            <!-- Column 2 -->
            <div class="col d-flex flex-column justify-content-start p-2 border-primary border-bottom">
                <h2 class="text-center mb-3">Escalations</h2>
                <canvas id="chart2"></canvas>
            </div>
        </div>
    </div>
    <div class="container shadow rounded-2">
        <div class="row">
            <!-- Column 3 -->
            <div class="col d-flex flex-column justify-content-start p-2 border-end border-primary">
                <h2 class="text-center mb-3">Common Questions</h2>
                <canvas id="chart3"></canvas>
            </div>

            <!-- Column 4 -->
            <div class="col d-flex flex-column justify-content-start p-2">
                <h2 class="text-center mb-3">Service Response Time</h2>
                <canvas id="chart4" class="mt-4"></canvas>
            </div>
        </div>
    </div>
}
else
{
        <div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-dark text-white">
        <div class="text-center p-5 border rounded-4 shadow-lg" style="background: linear-gradient(to right, #1f1f1f, #2c2c2c);">
            <h1 class="display-4 fw-bold mb-3">
                <i class="bi bi-chat-dots-fill text-info"></i> Campus SMS
            </h1>
            <p class="lead mb-4">
                Welcome to the AI SMS Helper – your smart assistant for sending and managing campus-wide SMS with ease.
                Whether it's announcements, alerts, or answers to common questions, our AI has you covered. Please register or sign in below
                to begin the Campus AI Revolution at your school
            </p>
            <a href="~/Identity/Account/Login" class="btn btn-lg btn-outline-info me-2">
                <i class="bi bi-box-arrow-in-right"></i> Sign In
            </a>
        </div>
    </div>
}

@section Scripts {
    <script type="text/javascript">
        var courseSmsCountLookup = @Html.Raw(Json.Serialize(Model.CourseSmsCount)); //For javascript object
        var courseEscalationCountLookup = @Html.Raw(Json.Serialize(Model.CourseEscalationCount)); //For javascript object
        var dailyResponseTimes = @Html.Raw(Json.Serialize(Model.DailyResponseTimes)); //For javascript object
        var courseCommonWords = @Html.Raw(Json.Serialize(Model.CourseCommonWords)); //For javascript object

        console.log(courseSmsCountLookup);
        console.log(dailyResponseTimes);
        console.log(courseCommonWords);
        console.log(courseEscalationCountLookup);


    </script>
    <!-- Bootstrap 5 JS for Tooltip functionality -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    // Initialize all tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
    });
</script>
    <script type="text/javascript" src="~/js/AdminDashboard.js"></script>
}
